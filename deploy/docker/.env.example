# Settings and secrets for deploy/docker/compose.yaml. Copy to .env next to
# compose.yaml, fill it in, and keep it private: chmod 600 .env
# Compose reads it twice: to fill in the command-line flags in compose.yaml,
# and (env_file) as the container's environment, which is how the secrets
# reach ngstoned. Put a value in single quotes if it contains a $, which
# Compose would otherwise treat as a variable.

# Base domain. Its apex and wildcard records must point at this host.
NGSTONE_DOMAIN=example.com

# Let's Encrypt account email.
NGSTONE_CERT_EMAIL=you@example.com

# staging until both certificates load, then production.
NGSTONE_ACME_CA=staging

# DNS host used for the DNS-01 challenges: cloudflare, route53, digitalocean,
# hetzner, vultr, ovh, desec or bunny. Set that provider's variables below.
NGSTONE_DNS_PROVIDER=cloudflare

# SHA-256 (hex) of the agent auth token; the edge never sees the token.
# Generate both on your laptop and keep the token, which "ngstone auth" uses:
#   TOKEN=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
#   printf '%s' "$TOKEN" | shasum -a 256 | cut -d' ' -f1   # or sha256sum
NGSTONE_TOKEN_SHA256=

# --- DNS provider credentials: set only the ones for NGSTONE_DNS_PROVIDER ---

# cloudflare: API token with Zone / DNS / Edit on this zone only.
NGSTONE_CF_API_TOKEN=

# route53: AWS region, for example us-east-1.
# NGSTONE_AWS_REGION=
# route53: access key ID of an IAM user allowed to change the hosted zone.
# NGSTONE_AWS_ACCESS_KEY_ID=
# route53: secret access key of that IAM user.
# NGSTONE_AWS_SECRET_ACCESS_KEY=

# digitalocean: personal access token with domain read and write.
# NGSTONE_DO_API_TOKEN=

# hetzner: Hetzner Console project API token, read and write.
# NGSTONE_HETZNER_API_TOKEN=

# vultr: API key, with this host's IP allowed in its access control.
# NGSTONE_VULTR_API_KEY=

# ovh: API endpoint, ovh-eu, ovh-ca or ovh-us.
# NGSTONE_OVH_ENDPOINT=
# ovh: application key.
# NGSTONE_OVH_APPLICATION_KEY=
# ovh: application secret.
# NGSTONE_OVH_APPLICATION_SECRET=
# ovh: consumer key limited to GET, POST and DELETE on /domain/zone/*.
# NGSTONE_OVH_CONSUMER_KEY=

# desec: token from desec.io.
# NGSTONE_DESEC_TOKEN=

# bunny: account API key.
# NGSTONE_BUNNY_API_KEY=
